# Rowanholt's reverse proxy on a server (deploy/server/docker-compose.server.yml).
#
# ROWANHOLT_TLS picks the certificate:
#   internal                        Caddy's own CA (the default): trust its root on clients,
#                                   rowanholt server ca prints it
#   you@example.org                 Let's Encrypt, for a name reachable from the internet
#   /certs/rowanholt.crt /certs/rowanholt.key
#                                   your organisation's certificate, in deploy/server/certs
#
# ROWANHOLT_HTTPS_PORT moves the web app off 443 (and the proxy off 80), for a host where
# something else is the front door (rowanholt server init --https-port)

{
	admin off
}

# Splunk, Kibana and the Navigator have no idea who Rowanholt's users are, so the
# backend vouches for each request; anyone not signed in goes to the sign-in page, and
# the Navigator's case layers follow job sharing
(signed_in) {
	forward_auth backend:5688 {
		uri /api/auth/verify?login_redirect=1&service={args[0]}
		copy_headers X-Rowanholt-User
	}
}

(headers) {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
}

(hardened) {
	tls {$ROWANHOLT_TLS}
	import headers
}

# The web app, API and Smith's MCP server. Every address people open is https, including a
# Tailscale Service name (Caddyfile.service), which reaches here over plain HTTP from Tailscale
# on the host's loopback: the backend is told so, or its redirects would point at http://
(app) {
	header X-Frame-Options SAMEORIGIN

	handle /api/* {
		reverse_proxy backend:5688 {
			header_up X-Forwarded-Proto https
			# Evidence uploads and long analyses
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
	# Smith's MCP server (the "mcp" profile; 502 when it isn't running) and the metadata MCP
	# clients read when it answers 401
	handle /mcp* {
		reverse_proxy smith-mcp:5690 {
			header_up X-Forwarded-Proto https
		}
	}
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy smith-mcp:5690 {
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		reverse_proxy frontend:80
	}
}

{$ROWANHOLT_HOSTNAME}:{$ROWANHOLT_HTTPS_PORT:443} {
	import hardened
	import app
}

{$ROWANHOLT_HOSTNAME}:7755 {
	import hardened
	import signed_in splunk
	reverse_proxy splunk:8000
}

{$ROWANHOLT_HOSTNAME}:5601 {
	import hardened
	import signed_in kibana
	reverse_proxy kibana:5601
}

{$ROWANHOLT_HOSTNAME}:5602 {
	import hardened
	import signed_in navigator
	reverse_proxy navigator:4200
}

# A Tailscale Service name for the server (server init --service): mounted only then, by
# deploy/server/docker-compose.service.yml; a glob that matches nothing imports nothing
import /etc/caddy/service*.caddy
