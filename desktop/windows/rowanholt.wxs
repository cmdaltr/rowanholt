<?xml version="1.0" encoding="utf-8"?>
<!--
  Rowanholt's Windows installer (WiX Toolset 5): Rowanholt-<version>-windows-universal.msi, for the
  current user, with no administrator rights, into %LOCALAPPDATA%\Programs\cmdaltr\Rowanholt, the
  way Shikari's MSI installs. It carries the launcher, the icon, LICENSE, the install and uninstall
  scripts (seed\) and the source tree as rowanholt-src.tar.gz; the launcher's first run does the
  setup (where Rowanholt runs, Docker, its files folder, evidence), as the Linux packages' does.

  Nothing in it is compiled, so one x86 package serves x64 and Arm64 Windows alike (the per-user
  folders and HKCU\Software aren't redirected for a 32-bit package). build-msi.ps1 builds it:
    powershell -File desktop\windows\build-msi.ps1 -Version 1.4.0 -Tarball rowanholt-src.tar.gz -OutDir dist

  Every component keys on an HKCU value, not a file: a per-user install has to (ICE38), so Windows
  Installer can tell what's installed without reading the user's profile.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- The UpgradeCode never changes: it's how a new MSI finds and replaces the installed one -->
  <Package Name="Rowanholt"
           Manufacturer="cmdaltr"
           Version="$(var.ProductVersion)"
           UpgradeCode="2960092C-3402-4618-A64F-289055BDD7C2"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">
    <SummaryInformation Description="Rowanholt DFIR platform" />

    <!-- Same version allowed: a rebuilt release (or an -rc, whose MSI version is its x.y.z) still replaces -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer Rowanholt is already installed. Remove it from Settings &gt; Apps first." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="rowanholt.ico" SourceFile="$(var.Root)\desktop\icons\rowanholt.ico" />
    <Property Id="ARPPRODUCTICON" Value="rowanholt.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/cmdaltr/rowanholt" />
    <Property Id="ARPHELPLINK" Value="https://github.com/cmdaltr/rowanholt/issues" />
    <!-- The wizard's options page ticks it; msiexec /i Rowanholt-....msi DESKTOPSHORTCUT=1 does too -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />

    <!-- What else to install, from the options page (or INSTALLDOCKER=1 and so on on msiexec's command
         line): recorded under HKCU\Software\cmdaltr\Rowanholt for the launcher, which downloads and
         installs them on its next start and clears the values. Docker Desktop is ticked when neither
         its per-user nor its all-users install is there; only in the wizard, so a /passive install
         (install.ps1, CI) never queues a download nobody asked for -->
    <Property Id="DOCKERFOUND">
      <RegistrySearch Id="DockerPerUser" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Docker Desktop" Name="DisplayName" Type="raw" />
    </Property>
    <Property Id="DOCKERFOUNDALLUSERS">
      <RegistrySearch Id="DockerAllUsers" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Docker Desktop" Name="DisplayName" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="DOCKERFOUND" Value="[DOCKERFOUNDALLUSERS]" After="AppSearch" Sequence="first" Condition="DOCKERFOUNDALLUSERS AND NOT DOCKERFOUND" />
    <Property Id="INSTALLDOCKER" Secure="yes" />
    <Property Id="INSTALLOLLAMA" Secure="yes" />
    <Property Id="INSTALLMODEL" Secure="yes" />
    <!-- The options page's one checkbox for both: the model needs Ollama, and Ollama is only there for it -->
    <Property Id="INSTALLAI" Secure="yes" />
    <SetProperty Id="INSTALLDOCKER" Value="1" After="SetDOCKERFOUND" Sequence="ui" Condition="NOT DOCKERFOUND AND NOT Installed" />

    <!-- Double-clicked, it's the wizard most Windows installers show (WixUI_Rowanholt below), with
         the Elastic License to accept; install.ps1's /passive shows none, and using the software
         is accepting it (README). build-msi.ps1 draws the banner and side panel -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenceRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />
    <UIRef Id="WixUI_Rowanholt" />

    <!-- The Finish page's "Launch Rowanholt": the Start menu shortcut's command, not waited for. With
         anything ticked on the options page, launching installs it first, and the checkbox says so -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Rowanholt" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchRowanholt" Directory="INSTALLFOLDER" Return="asyncNoWait"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[WindowsDir]Rowanholt.ps1&quot;" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="VendorDir" Name="cmdaltr">
          <Directory Id="INSTALLFOLDER" Name="Rowanholt">
            <Directory Id="AppDir" Name="desktop">
              <Directory Id="WindowsDir" Name="windows" />
              <Directory Id="IconsDir" Name="icons" />
            </Directory>
            <Directory Id="SeedDir" Name="seed" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Rowanholt">
      <!-- Fixed GUIDs on the components holding files: WiX only generates one for a file under a
           standard folder such as Program Files, and a per-user install's are under LocalAppData.
           Never change them, or an upgrade leaves the old files behind -->
      <Component Id="Bundle" Directory="INSTALLFOLDER" Guid="48B495E6-DE1B-4289-AC36-18FA51B34068">
        <RegistryValue Root="HKCU" Key="Software\cmdaltr\Rowanholt" Name="Bundle" Type="string" Value="[ProductVersion]" KeyPath="yes" />
        <File Id="Licence" Source="$(var.Root)\LICENSE" Name="LICENSE" />
        <File Id="Source" Source="$(var.Tarball)" Name="rowanholt-src.tar.gz" />
        <File Id="Version" Source="$(var.VersionFile)" Name="VERSION" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <!-- cmdaltr\ goes too once nothing else of cmdaltr's is in it (RemoveFolder only removes an empty one) -->
        <RemoveFolder Id="RemoveVendorDir" Directory="VendorDir" On="uninstall" />
      </Component>
      <Component Id="Launcher" Directory="WindowsDir" Guid="42880B17-4767-4E57-A7B9-1D8E8DDABFC3">
        <RegistryValue Root="HKCU" Key="Software\cmdaltr\Rowanholt" Name="Launcher" Type="integer" Value="1" KeyPath="yes" />
        <File Id="RowanholtPs1" Source="$(var.Root)\desktop\windows\Rowanholt.ps1" Name="Rowanholt.ps1" />
        <RemoveFolder Id="RemoveWindowsDir" On="uninstall" />
        <RemoveFolder Id="RemoveAppDir" Directory="AppDir" On="uninstall" />
      </Component>
      <Component Id="Icons" Directory="IconsDir" Guid="A36078FE-DF60-4B78-B615-34784A770BB7">
        <RegistryValue Root="HKCU" Key="Software\cmdaltr\Rowanholt" Name="Icons" Type="integer" Value="1" KeyPath="yes" />
        <File Id="RowanholtIco" Source="$(var.Root)\desktop\icons\rowanholt.ico" Name="rowanholt.ico" />
        <RemoveFolder Id="RemoveIconsDir" On="uninstall" />
      </Component>
      <!-- The launcher's windows show the PNG: .NET garbles an .ico's PNG-compressed sizes -->
      <Component Id="IconPng" Directory="IconsDir" Guid="6C1D2F0B-8E3A-4B57-9D21-3F6A0E7B5C84">
        <RegistryValue Root="HKCU" Key="Software\cmdaltr\Rowanholt" Name="IconPng" Type="integer" Value="1" KeyPath="yes" />
        <File Id="RowanholtPng" Source="$(var.Root)\desktop\icons\rowanholt.png" Name="rowanholt.png" />
      </Component>
      <!-- install.ps1 and uninstall.ps1 travel with the app, as Shikari's seed\ does: upgrade or remove
           it without the repository -->
      <Component Id="Seed" Directory="SeedDir" Guid="23E53571-9291-4BD0-A7CB-6A545FCA8413">
        <RegistryValue Root="HKCU" Key="Software\cmdaltr\Rowanholt" Name="Seed" Type="integer" Value="1" KeyPath="yes" />
        <File Id="InstallPs1" Source="$(var.Root)\desktop\install.ps1" Name="install.ps1" />
        <File Id="UninstallPs1" Source="$(var.Root)\desktop\uninstall.ps1" Name="uninstall.ps1" />
        <RemoveFolder Id="RemoveSeedDir" On="uninstall" />
      </Component>
      <Component Id="StartMenu" Directory="ProgramMenuFolder">
        <RegistryValue Root="HKCU" Key="Software\cmdaltr\Rowanholt" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        <!-- The console shows the road to Rowanholt while the stack starts, then closes -->
        <Shortcut Id="RowanholtShortcut" Name="Rowanholt" Description="Rowanholt DFIR platform"
                  Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[WindowsDir]Rowanholt.ps1&quot;"
                  WorkingDirectory="INSTALLFOLDER" Icon="rowanholt.ico" />
        <Shortcut Id="StopShortcut" Name="Stop Rowanholt" Description="Stop Rowanholt's containers"
                  Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[WindowsDir]Rowanholt.ps1&quot; -Stop"
                  WorkingDirectory="INSTALLFOLDER" Icon="rowanholt.ico" Show="minimized" />
        <!-- Setup was the installer's pages; it's the launcher's now, and this runs it again -->
        <Shortcut Id="SetupShortcut" Name="Set Up Rowanholt" Description="Choose where Rowanholt runs, its folder and evidence"
                  Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[WindowsDir]Rowanholt.ps1&quot; -Setup"
                  WorkingDirectory="INSTALLFOLDER" Icon="rowanholt.ico" />
      </Component>
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = 1">
        <RegistryValue Root="HKCU" Key="Software\cmdaltr\Rowanholt" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="RowanholtDesktop" Name="Rowanholt" Description="Rowanholt DFIR platform"
                  Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[WindowsDir]Rowanholt.ps1&quot;"
                  WorkingDirectory="INSTALLFOLDER" Icon="rowanholt.ico" />
      </Component>
      <!-- What the options page ticked; the launcher removes each value once it has tried -->
      <Component Id="WantDocker" Directory="INSTALLFOLDER" Condition="INSTALLDOCKER = 1">
        <RegistryValue Root="HKCU" Key="Software\cmdaltr\Rowanholt" Name="InstallDocker" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="WantOllama" Directory="INSTALLFOLDER" Condition="INSTALLOLLAMA = 1 OR INSTALLAI = 1">
        <RegistryValue Root="HKCU" Key="Software\cmdaltr\Rowanholt" Name="InstallOllama" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="WantModel" Directory="INSTALLFOLDER" Condition="INSTALLMODEL = 1 OR INSTALLAI = 1">
        <RegistryValue Root="HKCU" Key="Software\cmdaltr\Rowanholt" Name="InstallModel" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- Clears HKCU\Software\cmdaltr\Rowanholt on uninstall once its values are gone -->
      <Component Id="RegistryKey" Directory="INSTALLFOLDER">
        <RegistryKey Root="HKCU" Key="Software\cmdaltr\Rowanholt" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </Feature>
  </Package>

  <!-- WixUI_InstallDir's pages without its folder page (the folder is fixed: the launcher, the
       update check and uninstall.ps1 all look for it there), and an options page in its place.
       Repair and Remove from Settings > Apps go through the maintenance pages as usual -->
  <Fragment>
    <UI Id="WixUI_Rowanholt">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="ARPNOMODIFY" Value="1" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="220" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Choose what to install" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Ticked items are installed when Rowanholt first opens." />

        <Control Id="NeededText" Type="Text" X="20" Y="52" Width="330" Height="11" NoPrefix="yes" Text="{\WixUI_Font_Title}To run Rowanholt on this PC" />
        <Control Id="DockerCheckBox" Type="CheckBox" X="20" Y="64" Width="130" Height="14" Property="INSTALLDOCKER" CheckBoxValue="1"
                 Text="Docker Desktop and WSL 2" DisableCondition="DOCKERFOUND" EnableCondition="NOT DOCKERFOUND" />
        <Control Id="DockerFoundText" Type="Text" X="152" Y="66" Width="150" Height="11" NoPrefix="yes" Text="(already installed)"
                 ShowCondition="DOCKERFOUND" HideCondition="NOT DOCKERFOUND" />
        <Control Id="DockerText" Type="Text" X="33" Y="79" Width="320" Height="38" NoPrefix="yes"
                 Text="Runs Rowanholt's containers; from docker.com, for you alone. Ticking it accepts Docker's Subscription Service Agreement (free for personal use, education and small businesses). Turning WSL 2 on needs administrator rights and a restart." />

        <Control Id="OptionalText" Type="Text" X="20" Y="120" Width="330" Height="11" NoPrefix="yes" Text="{\WixUI_Font_Title}Optional" />
        <Control Id="AiCheckBox" Type="CheckBox" X="20" Y="132" Width="330" Height="14" Property="INSTALLAI" CheckBoxValue="1"
                 Text="Smith's AI answers: Ollama and Smith's model" />
        <Control Id="AiText" Type="Text" X="33" Y="147" Width="320" Height="44" NoPrefix="yes"
                 Text="Ollama (from ollama.com) runs AI models on this PC, so nothing leaves it; Smith's model, Meta's Llama 3.2 (3B), is the one Smith answers with. About 3 GB together. Without them, Smith answers fixed questions from the case files." />

        <Control Id="DesktopCheckBox" Type="CheckBox" X="20" Y="206" Width="330" Height="14" Property="DESKTOPSHORTCUT" CheckBoxValue="1"
                 Text="Add a Rowanholt shortcut to the &amp;desktop" />
      </Dialog>

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchRowanholt"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="OptionsDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="OptionsDlg" Control="Next" Property="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
               Value="Install what you chose, then open Rowanholt" Condition="INSTALLDOCKER = 1 OR INSTALLAI = 1 OR INSTALLOLLAMA = 1 OR INSTALLMODEL = 1" />
      <Publish Dialog="OptionsDlg" Control="Next" Property="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
               Value="Launch Rowanholt" Condition="NOT (INSTALLDOCKER = 1 OR INSTALLAI = 1 OR INSTALLOLLAMA = 1 OR INSTALLMODEL = 1)" />
      <Publish Dialog="OptionsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OptionsDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
