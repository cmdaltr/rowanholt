#!/usr/bin/env bash
# rowanholt - one command for the whole platform: the Docker stack, Gandalf, Elrond,
# Mordor, Anduril, the lab and every script under scripts/. `rowanholt install` links
# it into a directory on your PATH so it runs from anywhere.

# Follow symlinks to the real file, so a link in ~/.local/bin still finds the repo
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PYTHON="${ROWANHOLT_PYTHON:-python3}"

# ── Helpers ───────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
Usage: rowanholt <command> [options]

The platform (Docker):
  start | stop | restart | status   Run the stack (--testing: no Splunk/Elastic; --logs: follow logs;
                                    --server: the shared-server profile, automatic after 'server init';
                                    --progress[=zenity]: phases and an ETA, waiting for the web UI)
  server init|uninstall|users|licence|ca
                                    A team server: TLS proxy, sign-in, per-user jobs, licence (docs/SERVER.md);
                                    init and uninstall are deploy/linux/install.sh and deploy/linux/uninstall.sh
  anduril <command>                 Administer Rowanholt's containers (status, logs, restart, ...)

Forensics (run from the directory you're working in; relative paths stay relative):
  gandalf [bash|python] <args>      Collect from a Linux or macOS host (gandalf.sh by default)
  acquire <args>                    Gandalf through the Python CLI (rowanholt acquire --help)
  analyse <args>                    Elrond (rowanholt analyse --help); 'analyze' works too
  mordor <command>                  Security datasets: list, download, info, local, verify, ...
  samples list|fetch|import         Public forensic images as ready cases (ROWANHOLT_SAMPLES_DIR)
  symbols fetch|what|add|list       Volatility symbol tables for memory images, in the worker
                                    (fetch <image>; what <image>; add --package|--kdk <.dmg>|--vmlinux|--table)
  web                               The web UI and API without Docker
  mcp                               Smith's MCP server over stdio, for Claude Desktop, Claude Code and the like
                                    (ROWANHOLT_API, ROWANHOLT_TOKEN; needs requirements/mcp.txt; docs/SMITH.md)

The lab and the scripts:
  lab <command>                     The test lab (lab/lab.sh: linux-targets, windows-vm, gandalf-collect, ...)
  scripts                           List every script under scripts/
  <group> <name> [args]             Run one, e.g. 'rowanholt jobs status', 'rowanholt siem splunk-restart'

Set-up:
  install [dir]                     Link this command into dir (default ~/.local/bin) to run it from anywhere
  uninstall [dir]                   Remove that link
  app [install|uninstall] [--dock]  The desktop app: Rowanholt.app (macOS) or a menu entry (Linux)
  map [realm|elrond|gandalf|journey] Open an architecture page (journey is the 3D one)
  help                              This list

The Windows collector is PowerShell: run Invoke-Gandalf.ps1 from src/acquisition/windows
on Windows ('rowanholt where' prints the path).
EOF
}

compose_cmd() {
    # cd for the compose files only; every other command keeps the caller's directory
    (cd "$ROOT" && $DC $COMPOSE_FILES "$@")
}

selinux_enforcing() {
    [ "$(cat /sys/fs/selinux/enforce 2>/dev/null)" = 1 ]
}

# Rocky, RHEL and Alma ship Podman, and podman-docker answers to `docker`: Rowanholt needs
# Docker Engine itself (Andúril and the worker are untested on Podman's socket)
check_linux_docker() {
    [[ "$(uname)" == "Linux" ]] || return 0
    local found=""
    if command -v docker &>/dev/null; then
        docker --version 2>/dev/null | grep -qi podman || return 0
        found="'docker' here is Podman (podman-docker)"
    else
        found="Docker isn't installed"
    fi
    echo "Error: $found. Rowanholt needs Docker Engine; Podman isn't supported." >&2
    if grep -qiE '^ID(_LIKE)?=.*(rhel|fedora|centos)' /etc/os-release 2>/dev/null; then
        echo "  From Docker's own RHEL repository (docs/SERVER.md, Rocky, RHEL and Alma):" >&2
        echo "    sudo dnf remove -y podman-docker podman runc" >&2
        echo "    sudo dnf install -y dnf-plugins-core" >&2
        echo "    sudo dnf config-manager --add-repo https://download.docker.com/linux/rhel/docker-ce.repo" >&2
        echo "    sudo dnf install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin" >&2
        echo "    sudo systemctl enable --now docker" >&2
    else
        echo "  Install it from https://docs.docker.com/engine/install/" >&2
    fi
    exit 1
}

detect_compose() {
    check_linux_docker
    if docker compose version &>/dev/null; then
        DC="docker compose"
    elif command -v docker-compose &>/dev/null; then
        DC="docker-compose"
    else
        echo "Error: docker compose is not available." >&2
        exit 1
    fi
}

# Starts the engine the current Docker context points at (OrbStack or Docker Desktop),
# headless: no window, nothing new in the Dock. One that's already starting is waited
# for, not joined by the other.
start_docker_engine() {
    local context engine=""
    context="$(docker context show 2>/dev/null)"
    case "$context" in
        orbstack) engine=orbstack ;;
        desktop-linux) engine=desktop ;;
    esac
    if [ -z "$engine" ]; then
        if pgrep -q com.docker.backend; then engine=desktop
        elif [ -d /Applications/OrbStack.app ] || command -v orb &>/dev/null; then engine=orbstack
        else engine=desktop
        fi
    fi
    if [ "$engine" = orbstack ]; then
        echo "Starting OrbStack..."
        # orb start runs the engine without the app's window
        orb start &>/dev/null || open -g -j -a OrbStack
    else
        echo "Starting Docker Desktop..."
        if pgrep -q com.docker.backend; then
            echo "(already starting; waiting for it)"
        else
            docker desktop start --detach &>/dev/null || open -g -j -a Docker
        fi
    fi
}

ensure_docker() {
    if docker info &>/dev/null; then
        return 0
    fi
    echo "Docker is not running."
    if [[ "$(uname)" == "Darwin" ]]; then
        start_docker_engine
        for i in $(seq 1 180); do
            sleep 1
            if docker info &>/dev/null; then
                echo "Docker started."
                return 0
            fi
        done
        echo "Error: Docker did not start in time. Please start it manually." >&2
        exit 1
    else
        echo "Error: Docker is not running. Start it and retry." >&2
        exit 1
    fi
}

print_urls() {
    echo ""
    if $SERVER; then
        local host url other
        host="$(sed -n 's/^ROWANHOLT_HOSTNAME=//p' "$ROOT/.env" | tail -1)"
        url="$(sed -n 's/^ROWANHOLT_PUBLIC_URL=//p' "$ROOT/.env" | tail -1)"
        other="$(sed -n 's/^ROWANHOLT_OTHER_URLS=//p' "$ROOT/.env" | tail -1)"
        echo "  Rowanholt:     ${url:-https://$host}"
        [ -n "$other" ] && echo "  also at:       $other"
        if [ -n "$other" ]; then
            echo "  Splunk, Kibana, Navigator (with COMPOSE_PROFILES=siem): ${url%/}:7755, :5601, :5602"
        else
            echo "  Splunk, Kibana, Navigator (with COMPOSE_PROFILES=siem): https://$host:7755, :5601, :5602"
        fi
        echo ""
        echo "  Users: 'rowanholt server users list'. Nothing else is published."
        echo ""
        return
    fi
    if $TESTING; then
        echo "  Frontend:    http://localhost:5687"
        echo "  Backend API: http://localhost:5688"
        echo ""
        echo "  (Splunk, Kibana, Elasticsearch, Navigator disabled in testing mode)"
    else
        echo "  Frontend:      http://localhost:5687"
        echo "  Backend API:   http://localhost:5688"
        echo "  Splunk:        http://localhost:7755"
        echo "  Kibana:        http://localhost:5601"
        echo "  Elasticsearch: http://localhost:9200"
        echo "  Navigator:     http://localhost:5602"
    fi
    echo ""
    echo "  Sign in:       admin, with DEFAULT_ADMIN_PASSWORD from .env (else default_admin_password in src/web/backend/config.py)"
    echo ""
}

# ── The stack ─────────────────────────────────────────────────────────────────
stack() {
    local command="$1" arg
    shift
    TESTING=false
    FOLLOW_LOGS=false
    SERVER=false
    PROGRESS=""
    # `rowanholt server init` marks a server in .env; --server asks for it explicitly
    grep -q '^ROWANHOLT_DEPLOYMENT=server' "$ROOT/.env" 2>/dev/null && SERVER=true
    for arg in "$@"; do
        case "$arg" in
            --testing) TESTING=true ;;
            --logs)    FOLLOW_LOGS=true ;;
            --server)  SERVER=true ;;
            --progress) PROGRESS=json ;;
            --progress=zenity) PROGRESS=zenity ;;
            *)
                echo "Error: unknown argument: $arg" >&2
                exit 1
                ;;
        esac
    done
    detect_compose
    COMPOSE_FILES="-f docker-compose.yml"
    if $TESTING; then
        COMPOSE_FILES="$COMPOSE_FILES -f tests/docker-compose.testing.yml"
    fi
    if $SERVER; then
        server_preflight
        COMPOSE_FILES="$COMPOSE_FILES -f deploy/server/docker-compose.server.yml"
        # A Tailscale Service name (server init --service): the proxy's loopback sites for it
        if [ -n "$(sed -n 's/^ROWANHOLT_SERVICE=//p' "$ROOT/.env" | tail -1)" ]; then
            COMPOSE_FILES="$COMPOSE_FILES -f deploy/server/docker-compose.service.yml"
        fi
    fi
    # SELinux enforcing: the services with host folders mounted run unlabelled (the file says why)
    if selinux_enforcing; then
        COMPOSE_FILES="$COMPOSE_FILES -f deploy/docker-compose.selinux.yml"
        $SERVER && COMPOSE_FILES="$COMPOSE_FILES -f deploy/server/docker-compose.selinux.yml"
    fi
    # Evidence folders added in the desktop app's setup (gitignored, so a pull never touches it)
    if [ -f "$ROOT/docker-compose.local.yml" ]; then
        COMPOSE_FILES="$COMPOSE_FILES -f docker-compose.local.yml"
    fi
    if [ "$command" = start ] && [ -n "$PROGRESS" ] && progress_python; then
        start_with_progress
        return
    fi
    ensure_docker
    case "$command" in
        start)
            not_migrated && exit 1
            echo "Starting Rowanholt..."
            prepare_app_copy
            $SERVER && remove_renamed_containers
            check_resources || exit 1
            compose_cmd up -d $BUILD_FLAG || exit 1
            [ -n "$BUILD_FLAG" ] && printf '%s\n' "$BUILT_VERSION" > "$ROOT/.rowanholt-built"
            print_urls
            # Not `$FOLLOW_LOGS && ...`: without --logs that leaves start's exit status at 1
            if $FOLLOW_LOGS; then compose_cmd logs -f; fi
            ;;
        stop)
            echo "Stopping Rowanholt..."
            compose_cmd down --remove-orphans 2>/dev/null || true
            echo "Stopped."
            ;;
        restart)
            stack stop
            stack start "$@"
            ;;
        status)
            echo "Rowanholt service status:"
            echo ""
            compose_cmd ps
            ;;
    esac
}

# rowanholt symbols, in the worker, which has Volatility, dwarf2json and the symbols folders.
# Files the worker can't see (it mounts /tmp/rowanholt, and /Volumes on a Mac) are staged under
# /tmp/rowanholt first, and a KDK's .dmg or .pkg is unpacked here on the Mac (hdiutil, pkgutil:
# the worker can't open Apple's package format); the staging folder is removed afterwards
symbols_visible() {
    case "$1" in
        /tmp/rowanholt/*) return 0 ;;
        /Volumes/*) [ "$(uname)" = Darwin ] ;;
        *) return 1 ;;
    esac
}

symbols_unpack_kdk() {  # <.dmg|.pkg> <staging folder>: prints the expanded KDK's folder
    local file="$1" stage="$2" mnt pkg
    [ "$(uname)" = Darwin ] || { echo "A KDK's .dmg or .pkg is unpacked on a Mac; unpack it there and pass the folder" >&2; return 1; }
    pkg="$file"
    if [[ "$file" == *.dmg ]]; then
        mnt="$(mktemp -d)"
        hdiutil attach -nobrowse -readonly -mountpoint "$mnt" "$file" >/dev/null || { rmdir "$mnt"; return 1; }
        pkg="$(find "$mnt" -maxdepth 2 -name '*.pkg' | head -1)"
        [ -n "$pkg" ] || { hdiutil detach -quiet "$mnt"; echo "No .pkg in $file" >&2; return 1; }
    fi
    echo "Unpacking $(basename "$pkg") (a few minutes)..." >&2
    pkgutil --expand-full "$pkg" "$stage/kdk" >/dev/null
    local status=$?
    [ -n "${mnt:-}" ] && hdiutil detach -quiet "$mnt"
    [ $status -eq 0 ] || return 1
    echo "$stage/kdk"
}

symbols_command() {
    ensure_docker
    docker ps --format '{{.Names}}' | grep -qx rowanholt-celery-worker \
        || { echo "The worker isn't running: rowanholt start" >&2; exit 1; }
    local stage="" args=() prev="" arg path status
    for arg in "$@"; do
        if [ -e "$arg" ] && [[ "$prev" != --banner ]] && [[ "$prev" != --kernel ]]; then
            path="$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")"
            if [[ "$prev" == --kdk && ( "$path" == *.dmg || "$path" == *.pkg ) ]]; then
                [ -n "$stage" ] || stage="$(mkdir -p /tmp/rowanholt && mktemp -d /tmp/rowanholt/symbols-XXXXXX)"
                path="$(symbols_unpack_kdk "$path" "$stage")" || { rm -rf "$stage"; exit 1; }
            elif ! symbols_visible "$path"; then
                [ -n "$stage" ] || stage="$(mkdir -p /tmp/rowanholt && mktemp -d /tmp/rowanholt/symbols-XXXXXX)"
                if [ -d "$path" ]; then
                    # A KDK folder: only its kernels are needed
                    mkdir -p "$stage/$(basename "$path")/System/Library"
                    cp -R "$path/System/Library/Kernels" "$stage/$(basename "$path")/System/Library/" || { rm -rf "$stage"; exit 1; }
                else
                    cp "$path" "$stage/" || { rm -rf "$stage"; exit 1; }
                fi
                path="$stage/$(basename "$path")"
            fi
            arg="$path"
        fi
        args+=("$arg")
        prev="$arg"
    done
    TTY=-i; [ -t 0 ] && [ -t 1 ] && TTY=-it
    docker exec "$TTY" -e ROWANHOLT_SYMBOL_DOWNLOADS=on rowanholt-celery-worker \
        /usr/bin/python3 -m rowanholt.memory.symbols "${args[@]}"
    status=$?
    [ -n "$stage" ] && rm -rf "$stage"
    exit $status
}

# An install from before the rename starts on new, empty volumes and without its .env
# settings until it's moved across, so it looks as if every job were gone: say so instead
not_migrated() {
    if grep -q '^RIVENDELL_' "$ROOT/.env" 2>/dev/null \
        || { docker volume inspect rivendell_postgres_data &>/dev/null \
             && ! docker volume inspect rowanholt_postgres_data &>/dev/null; }; then
        echo "This install's settings and data are still under the name Rivendell." >&2
        echo "Move them across first: rowanholt migrate from-rivendell" >&2
        return 0
    fi
    return 1
}

# The machine against docs/REQUIREMENTS.md (src/common/resources.py): stops under the floors,
# 30 GB free only when there are images to build; warns under the minimums. start --progress
# runs the same check itself
check_resources() {
    progress_python || return 0
    local building=() image
    if [ -n "$BUILD_FLAG" ]; then
        building=(--building)
    else
        while read -r image; do
            [ -n "$image" ] || continue
            docker image inspect "$image" &>/dev/null || { building=(--building); break; }
        done < <(compose_cmd config --images 2>/dev/null)
    fi
    "$PYTHON" "$ROOT/src/common/resources.py" "${building[@]}"
}

# start --progress: src/common/startup_progress.py wakes Docker, starts the stack and
# waits for the web UI, timing each phase against this machine's earlier starts for the
# ETA (Rowanholt.app's journey; zenity on Linux)
progress_python() {
    command -v "$PYTHON" &>/dev/null || return 1
    # On a Mac without the command-line tools, /usr/bin/python3 is a stub that opens an installer
    if [[ "$(uname)" == "Darwin" ]] && [ "$(command -v "$PYTHON")" = /usr/bin/python3 ] && ! xcode-select -p &>/dev/null; then
        return 1
    fi
}

start_with_progress() {
    local url="http://localhost:5687" status
    not_migrated && exit 1
    $SERVER && url="https://localhost"
    prepare_app_copy
    $SERVER && remove_renamed_containers
    local args=(--root "$ROOT" --url "$url")
    [ -n "$BUILD_FLAG" ] && args+=(--build)
    $SERVER && args+=(--server)
    [ "$PROGRESS" = zenity ] && args+=(--zenity)
    # shellcheck disable=SC2086 # DC and COMPOSE_FILES are word lists
    "$PYTHON" "$ROOT/src/common/startup_progress.py" "${args[@]}" -- $DC $COMPOSE_FILES
    status=$?
    [ $status -eq 0 ] || exit $status
    [ -n "$BUILD_FLAG" ] && printf '%s\n' "$BUILT_VERSION" > "$ROOT/.rowanholt-built"
    [ "$PROGRESS" = zenity ] || print_urls
}

# The MCP server's containers under the analyst's old names (Aulë until 12 November 2026, Eru
# before): `up` leaves a renamed service's container running as an orphan, and it would still
# answer on the network beside rowanholt-smith-mcp, with the old code
remove_renamed_containers() {
    local name
    for name in rowanholt-aule-mcp rowanholt-eru-mcp; do
        docker rm -f "$name" >/dev/null 2>&1 && echo "Removed $name: it's rowanholt-smith-mcp now"
    done
    return 0
}

# The server profile resets the base file's published ports with !reset (Compose 2.24)
server_preflight() {
    local version major minor
    version="$($DC version --short 2>/dev/null | sed 's/^v//')"
    major="${version%%.*}"; minor="${version#*.}"; minor="${minor%%.*}"
    if [ "${major:-0}" -lt 2 ] || { [ "$major" -eq 2 ] && [ "${minor:-0}" -lt 24 ]; }; then
        echo "Error: the server profile needs Docker Compose 2.24 or later (this is ${version:-unknown})." >&2
        exit 1
    fi
    if ! grep -q '^ROWANHOLT_HOSTNAME=' "$ROOT/.env" 2>/dev/null; then
        echo "Error: this isn't set up as a server yet. Run: rowanholt server init <hostname>" >&2
        exit 1
    fi
}

# A copy the desktop app installed (not a git clone) carries .rowanholt-version. It gets
# a .env with its own SECRET_KEY on first start, and its images are rebuilt once after
# each update, since the worker image copies the source in at build time. A server's git
# checkout is rebuilt the same way after a pull or checkout, by commit: otherwise its
# worker goes on running the Elrond it was first built with. A desktop checkout isn't
# (development rebuilds when it chooses).
prepare_app_copy() {
    BUILD_FLAG=""
    BUILT_VERSION=""
    if [ -f "$ROOT/.rowanholt-version" ]; then
        BUILT_VERSION="$(cat "$ROOT/.rowanholt-version")"
        if [ ! -f "$ROOT/.env" ] && [ -f "$ROOT/.env.example" ]; then
            local key
            key="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
            sed "s/^SECRET_KEY=.*/SECRET_KEY=$key/" "$ROOT/.env.example" > "$ROOT/.env"
            chmod 600 "$ROOT/.env"
            echo "Created .env with a new SECRET_KEY."
        fi
    elif $SERVER && [ -d "$ROOT/.git" ]; then
        BUILT_VERSION="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)"
    fi
    [ -n "$BUILT_VERSION" ] || return 0
    if [ "$BUILT_VERSION" != "$(cat "$ROOT/.rowanholt-built" 2>/dev/null)" ]; then
        echo "New Rowanholt version: rebuilding the images (this takes a while)..."
        BUILD_FLAG="--build"
    fi
}

# ── Scripts under scripts/ ────────────────────────────────────────────────────
# scripts/<group>/<group>-<name>.sh or scripts/<group>/<name>.{sh,py}, and the
# top-level scripts/<name>.{sh,py}: found at run time, so new scripts need no wiring
find_script() {
    local group="$1" name="${2:-}" candidate
    if [ -d "$ROOT/scripts/$group" ] && [ -n "$name" ]; then
        for candidate in "$ROOT/scripts/$group/$group-$name.sh" "$ROOT/scripts/$group/$name.sh" \
                         "$ROOT/scripts/$group/$name.py" "$ROOT/scripts/$group/$name"; do
            [ -f "$candidate" ] && { echo "$candidate"; return 0; }
        done
    fi
    for candidate in "$ROOT/scripts/$group.sh" "$ROOT/scripts/$group.py"; do
        [ -f "$candidate" ] && { echo "$candidate"; return 0; }
    done
    return 1
}

script_summary() {
    # The first comment line after the shebang, or the first docstring line
    sed -n '2,8p' "$1" | grep -m1 -E '^# *[A-Za-z]|^[A-Za-z].*' | sed -E 's/^# *//; s/^"""//' | cut -c1-70
}

list_scripts() {
    local file rel group name
    echo "Scripts (run from the repository root, wherever you are):"
    echo ""
    for file in "$ROOT"/scripts/*.sh "$ROOT"/scripts/*.py "$ROOT"/scripts/*/*.sh "$ROOT"/scripts/*/*.py; do
        [ -f "$file" ] || continue
        rel="${file#"$ROOT"/scripts/}"
        name="$(basename "$rel")"; name="${name%.*}"
        if [[ "$rel" == */* ]]; then
            group="${rel%%/*}"
            name="${name#"$group"-}"
            printf '  rowanholt %-34s %s\n' "$group $name" "$(script_summary "$file")"
        else
            printf '  rowanholt %-34s %s\n' "$name" "$(script_summary "$file")"
        fi
    done
    # The team-server installers, in deploy/linux/ (dispatched by name, below)
    printf '  rowanholt %-34s %s\n' "server init" "$(script_summary "$ROOT/deploy/linux/install.sh")"
    printf '  rowanholt %-34s %s\n' "server uninstall" "$(script_summary "$ROOT/deploy/linux/uninstall.sh")"
}

run_script() {
    local script="$1"
    shift
    cd "$ROOT" || exit 1
    case "$script" in
        *.py) exec "$PYTHON" "$script" "$@" ;;
        *)    exec bash "$script" "$@" ;;
    esac
}

# ── Install ───────────────────────────────────────────────────────────────────
install_link() {
    local dir="${1:-$HOME/.local/bin}"
    mkdir -p "$dir" || exit 1
    if [ -e "$dir/rowanholt" ] && [ ! -L "$dir/rowanholt" ]; then
        echo "Error: $dir/rowanholt exists and isn't a link; not replacing it." >&2
        exit 1
    fi
    ln -sfn "$ROOT/rowanholt" "$dir/rowanholt"
    echo "Linked $dir/rowanholt -> $ROOT/rowanholt"
    case ":$PATH:" in
        *":$dir:"*) echo "Run 'rowanholt help' from anywhere." ;;
        *)
            echo ""
            echo "$dir isn't on your PATH. Add it to your shell profile:"
            echo "  echo 'export PATH=\"$dir:\$PATH\"' >> ~/.zshrc   # or ~/.bashrc"
            ;;
    esac
}

uninstall_link() {
    local dir="${1:-$HOME/.local/bin}"
    if [ -L "$dir/rowanholt" ]; then
        rm "$dir/rowanholt"
        echo "Removed $dir/rowanholt"
    else
        echo "No rowanholt link in $dir"
    fi
}

# The desktop app: desktop/macos builds Rowanholt.app, desktop/linux installs a desktop entry;
# on Windows it's desktop/windows/install.ps1, run from PowerShell
desktop_app() {
    local action="${1:-install}"
    [ $# -gt 0 ] && shift
    case "$action" in
        install|uninstall) ;;
        *) echo "Usage: rowanholt app [install|uninstall] [--dock] [dir]" >&2; return 1 ;;
    esac
    case "$(uname -s)" in
        Darwin)
            if [ "$action" = uninstall ]; then
                exec bash "$ROOT/desktop/macos/build.sh" --uninstall "$@"
            fi
            exec bash "$ROOT/desktop/macos/build.sh" "$@" ;;
        Linux)
            if [ "$action" = uninstall ]; then
                exec bash "$ROOT/desktop/linux/install.sh" --uninstall
            fi
            exec bash "$ROOT/desktop/linux/install.sh" ;;
        *)
            echo "On Windows, from PowerShell:" >&2
            echo "  powershell -ExecutionPolicy Bypass -File \"$ROOT/desktop/windows/install.ps1\"" >&2
            return 1 ;;
    esac
}

open_map() {
    local dir="$ROOT/src/web/frontend/public/architecture" page
    case "${1:-realm}" in
        realm|elrond) page="rowanholt-architecture.html#${1:-realm}" ;;
        gandalf)      page="gandalf-acquisition.html" ;;
        journey|machine)
            # ES modules don't load from file://, so the 3D page is served on loopback
            local port="${ROWANHOLT_MAP_PORT:-5690}"
            echo "The Rowanholt journey: http://127.0.0.1:$port/rowanholt-journey.html (Ctrl-C to stop)"
            (sleep 1; open_url "http://127.0.0.1:$port/rowanholt-journey.html") &
            exec "${ROWANHOLT_PYTHON:-python3}" -m http.server "$port" --bind 127.0.0.1 -d "$dir" ;;
        *) echo "Unknown map '$1': realm, elrond, gandalf or journey" >&2; return 1 ;;
    esac
    open_url "file://$dir/$page"
}

open_url() {
    if command -v open &>/dev/null; then open "$1"
    elif command -v xdg-open &>/dev/null; then xdg-open "$1"
    else echo "$1"
    fi
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
COMMAND="${1:-}"
[ -n "$COMMAND" ] && shift

case "$COMMAND" in
    ""|help|-h|--help) usage ;;
    start|stop|restart|status) stack "$COMMAND" "$@" ;;
    install) install_link "$@" ;;
    uninstall) uninstall_link "$@" ;;
    map) open_map "$@" ;;
    app) desktop_app "$@" ;;
    where) echo "$ROOT" ;;
    lab) exec "$ROOT/lab/lab.sh" "$@" ;;
    gandalf)
        case "${1:-bash}" in
            python) shift; exec "$PYTHON" "$ROOT/src/acquisition/python/gandalf.py" "$@" ;;
            bash) [ "${1:-}" = bash ] && shift; exec bash "$ROOT/src/acquisition/bash/gandalf.sh" "$@" ;;
            *) exec bash "$ROOT/src/acquisition/bash/gandalf.sh" "$@" ;;
        esac
        ;;
    acquire|web) exec "$PYTHON" "$ROOT/src/cli/rowanholt.py" "$COMMAND" "$@" ;;
    analyse|analyze) exec "$PYTHON" "$ROOT/src/cli/rowanholt.py" analyze "$@" ;;
    anduril|aragorn) exec "$PYTHON" "$ROOT/src/cli/rowanholt.py" anduril "$@" ;;
    mordor) exec "$PYTHON" "$ROOT/src/cli/mordor.py" "$@" ;;
    samples) exec "$PYTHON" "$ROOT/src/cli/samples.py" "$@" ;;
    # In the worker, which has Volatility, dwarf2json and the symbols folders; an image or file
    # must be at a path the worker mounts (/Volumes, /tmp/rowanholt, an evidence folder)
    symbols) symbols_command "$@" ;;
    # stdout is the MCP protocol: nothing else may print to it
    mcp) PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec "${ROWANHOLT_MCP_PYTHON:-$PYTHON}" -m smith_mcp.server "$@" ;;
    scripts) list_scripts ;;
    *)
        # The team-server installers live in deploy/linux/, at Shikari's and Ostraka's paths, not
        # under scripts/server/ with the other server helpers that the generic lookup finds
        if [ "$COMMAND" = server ]; then
            case "${1:-}" in
                init) shift; exec bash "$ROOT/deploy/linux/install.sh" "$@" ;;
                uninstall) shift; exec bash "$ROOT/deploy/linux/uninstall.sh" "$@" ;;
            esac
        fi
        if [ -d "$ROOT/scripts/$COMMAND" ] && [ -z "${1:-}" ]; then
            list_scripts | grep -E "^  rowanholt $COMMAND " || true
            exit 0
        fi
        if SCRIPT="$(find_script "$COMMAND" "${1:-}")"; then
            [ -d "$ROOT/scripts/$COMMAND" ] && shift
            run_script "$SCRIPT" "$@"
        fi
        echo "Error: unknown command: $COMMAND" >&2
        echo "Run 'rowanholt help' for the commands, 'rowanholt scripts' for the scripts." >&2
        exit 1
        ;;
esac
