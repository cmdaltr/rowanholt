# Docker ignore file for celery-worker build context
# Excludes unnecessary files when copying src/analysis and src/web/backend

# Git
.git
.gitignore
.gitattributes

# Documentation and config files
*.md
LICENSE
*.yml
*.yaml
!docker-compose.yml

# Python cache
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info
.eggs
.mypy_cache
.pytest_cache

# Virtual environments
.env
.venv
env/
venv/
ENV/

# IDE
.idea
.vscode
*.swp
*.swo

# macOS
.DS_Store
._*

# Node modules (frontend)
node_modules
src/web/frontend/node_modules
src/analysis/web/frontend/node_modules

# Build artifacts
dist
build

# Test data and output (don't include large forensic images). A pattern without **/ matches
# only at the top: a case once written into src/web/backend went into the worker image
**/*.E01
**/*.e01
**/*.Ex01
**/*.raw
**/*.mem
**/*.vmdk
**/*.dd
**/*.pst
test_data
tests/fixtures

# Logs
*.log
logs/

# Docker files (except what we need)
Dockerfile
!src/web/backend/Dockerfile
!src/web/backend/Dockerfile.forensics

# Accounts and the JWT signing key (src/web/backend/.dockerignore says why)
src/web/backend/data/users.json
src/web/backend/data/.jwt_secret
