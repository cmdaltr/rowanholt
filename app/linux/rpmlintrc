# rpmlint 1.x (Rocky 9) for package-rpm.sh's package: rpmlint -f app/linux/rpmlintrc <rpm>. Filtered
# on purpose: /opt/rowanholt is the .deb's layout too, a self-contained third-party app; the launcher
# keeps its `env bash` shebang, as in the .deb; it's a launcher, so no docs; Tolkien isn't in the dictionary.
addFilter("dir-or-file-in-opt")
addFilter("env-script-interpreter")
addFilter("desktopfile-without-binary")
addFilter("no-documentation")
addFilter("spelling-error")
