[Desktop Entry]
Type=Application
Name=Dernvale
GenericName=DFIR Platform
Comment=Gandalf, Elrond and Eru: acquisition, analysis and the AI analyst
Exec=@EXEC@
Icon=dernvale
Terminal=false
Categories=Development;Security;
Keywords=DFIR;forensics;Gandalf;Elrond;Eru;
StartupNotify=true
StartupWMClass=Dernvale
Actions=Setup;Stop;

[Desktop Action Setup]
Name=Set Up Dernvale
Exec=@EXEC@ --setup

[Desktop Action Stop]
Name=Stop Dernvale
Exec=@EXEC@ --stop
