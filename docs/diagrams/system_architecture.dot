digraph SystemArchitecture {
    rankdir=TB;

    // Graph styling
    graph [fontname="Arial", fontsize=12, bgcolor="#0f0f23", pad=0.5];
    node [fontname="Arial", fontsize=10, style=filled, shape=box, fillcolor="#2d2d44", fontcolor="#f0dba5", color="#3f4b2a"];
    edge [fontname="Arial", fontsize=9, color="#66d9ef", fontcolor="#a7db6c"];

    // Client Layer
    subgraph cluster_client {
        label="Client Layer";
        style=filled;
        fillcolor="#1a1a2e";
        fontcolor="#66d9ef";
        fontsize=14;

        browser [label="Browser\n(React web app)", shape=box3d, fillcolor="#3a506b"];
        desktop [label="Desktop App\n(macOS, Linux, Windows)", shape=box3d, fillcolor="#3a506b"];
        api_client [label="API Client\n(API token)", shape=box3d, fillcolor="#3a506b"];
        mcp_host [label="MCP Host\n(Smith's MCP server)", shape=box3d, fillcolor="#3a506b"];
    }

    // Presentation Layer
    subgraph cluster_presentation {
        label="Presentation Layer";
        style=filled;
        fillcolor="#1a1a2e";
        fontcolor="#66d9ef";
        fontsize=14;

        caddy [label="Caddy (team server)\nPort: 8443, Tailscale Service 5680-5683\n• TLS\n• Sign-in (forward_auth)\n• Content-Security-Policy", shape=cylinder, fillcolor="#5c7cfa"];
        frontend [label="React Frontend\nVite dev server 127.0.0.1:5687 (local)\nNginx production build (server)", shape=component, fillcolor="#4dabf7"];
        backend [label="FastAPI Backend\nPort: 5688", shape=component, fillcolor="#51cf66"];
    }

    // Application Layer
    subgraph cluster_application {
        label="Application Layer";
        style=filled;
        fillcolor="#1a1a2e";
        fontcolor="#66d9ef";
        fontsize=14;

        subgraph cluster_routes {
            label="API Routes";
            style=dashed;
            fontcolor="#a7db6c";

            auth_routes [label="Auth\nRoutes", fillcolor="#ffd43b"];
            job_routes [label="Job\nRoutes", fillcolor="#ffd43b"];
            case_routes [label="Case\nBrowser", fillcolor="#ffd43b"];
            smith_routes [label="Smith", fillcolor="#ffd43b"];
            module_routes [label="Lookout, Crucible,\nSteward, Quartermaster", fillcolor="#ffd43b"];
        }

        business_logic [label="Business Logic Layer\n• Sign-in, MFA, reset links, invitations, API tokens, SSO\n• Job management, sharing and liveness\n• Case findings, notes and hosts\n• SIEM export", shape=folder, fillcolor="#74c0fc"];
        smith_mcp [label="Smith's MCP Server\n(/mcp on a team server)", shape=component, fillcolor="#74c0fc"];
    }

    // Task Processing Layer
    subgraph cluster_processing {
        label="Task Processing Layer";
        style=filled;
        fillcolor="#1a1a2e";
        fontcolor="#66d9ef";
        fontsize=14;

        celery_workers [label="Celery Worker\n• Acquisition\n• Analysis\n• SIEM export", shape=hexagon, fillcolor="#ffa94d"];
        forensic_engine [label="Forensic Analysis Engine\n• Ledger (Analysis)\n• Custodian (Acquisition)\n• Plaso (Timeline)\n• Volatility 3 (Memory)", shape=box3d, fillcolor="#ff6b6b"];
        model [label="Smith's Model\nOllama or OpenAI-compatible\n(private addresses only)", shape=box3d, fillcolor="#ff6b6b"];
    }

    // Data Layer
    subgraph cluster_data {
        label="Data Layer";
        style=filled;
        fillcolor="#1a1a2e";
        fontcolor="#66d9ef";
        fontsize=14;

        postgresql [label="PostgreSQL\nDatabase\n• Jobs and sharing\n• Case findings, notes, hosts\n• API tokens\n• Audit log\n• Threat intelligence", shape=cylinder, fillcolor="#20c997"];
        redis [label="Redis\n• Task Queue\n• Sign-in lockout\n• Job heartbeats", shape=cylinder, fillcolor="#fa5252"];
        user_files [label="User Store\n• users.json\n• invitations.json", shape=folder, fillcolor="#845ef7"];
        filesystem [label="File System\nStorage\n• Evidence folders\n• Case directories\n• Reports", shape=folder, fillcolor="#845ef7"];
        siems [label="SIEMs (optional)\n• Splunk\n• Elastic and Kibana\n• ATT&CK Navigator", shape=cylinder, fillcolor="#20c997"];
    }

    // Connections - Client to Presentation
    browser -> caddy [label="HTTPS\n(server)"];
    browser -> frontend [label="HTTP\n(local)"];
    desktop -> frontend [label="Web View\n(local)"];
    desktop -> caddy [label="HTTPS\n(server)"];
    api_client -> caddy [label="HTTPS"];
    mcp_host -> caddy [label="HTTPS\n/mcp"];

    // Connections - Presentation Layer
    caddy -> frontend [label="Static\nFiles"];
    caddy -> backend [label="API\nRequests"];
    caddy -> smith_mcp [label="/mcp"];
    caddy -> siems [label="Signed-in\nPorts"];
    frontend -> backend [label="/api proxy\n(local)"];
    smith_mcp -> backend [label="API\n(read-only)"];

    // Connections - Application Layer
    backend -> auth_routes [label="Routes"];
    backend -> job_routes [label="Routes"];
    backend -> case_routes [label="Routes"];
    backend -> smith_routes [label="Routes"];
    backend -> module_routes [label="Routes"];
    auth_routes -> business_logic;
    job_routes -> business_logic;
    case_routes -> business_logic;
    module_routes -> business_logic;
    smith_routes -> model [label="Prompts"];

    // Connections - Processing Layer
    business_logic -> celery_workers [label="Dispatch\nTasks"];
    celery_workers -> forensic_engine [label="Execute\nAnalysis"];
    celery_workers -> siems [label="Export"];

    // Connections - Data Layer
    business_logic -> postgresql [label="CRUD\nOperations"];
    business_logic -> redis [label="Queue/\nLockout"];
    business_logic -> user_files [label="Accounts\n(file lock)"];
    forensic_engine -> filesystem [label="Read/Write\nEvidence"];
    celery_workers -> redis [label="Task\nQueue"];
    smith_routes -> filesystem [label="Case Files\n(read-only)"];
}
