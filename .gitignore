# Security / hygiene (added by FlightDeck)
*.pem
secrets.*
credentials.*

# Test lab: generated per machine
lab/docker-compose.lab.yml

# Recorded telemetry (src/mordor/telemetry): build state, and lab recordings that hold host names
src/mordor/data/cache/
src/mordor/data/telemetry/

# Volatility 3 symbol tables (large, per kernel); see symbols/README.md
symbols/linux/*.json*
symbols/mac/*.json*

# Third-party Windows tools (RawCopy, Sleuth Kit): only a fallback for the raw volume reader
src/acquisition/tools/disk_tools.zip

# Desktop app: evidence mounts from setup, and the version markers of an app-installed copy
docker-compose.local.yml
.rowanholt-version
.rowanholt-built

# A server's own TLS certificate and key (deploy/server/certs/README)
deploy/server/certs/*
!deploy/server/certs/README

# The YouTube walkthrough: kept locally, not committed, except its README
scripts/docs/video/*
!scripts/docs/video/README.md
symbols/linux/rowanholt.index
symbols/mac/*.json*
symbols/mac/rowanholt.index
symbols/*/rowanholt-symbols.log
symbols/incoming/

# Licensing: never commit a signing key or an issued licence
licences/
*licence-signing-key*
*licence-signing.key
*.lic.key
*.licence

# Claude Code session artefacts: command-audit logs and session notes stay on this machine
.claude/logs/
.claude/snapshots/
# The older copies OneDrive leaves beside a file when it re-fetches it
*.fetch
